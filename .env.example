SITE_DOMAIN=stirisk.cloudmonkey.co.za
PUBLIC_BASE_URL=https://stirisk.cloudmonkey.co.za

# Required production secrets. Generate strong unique values before deploy.
POSTGRES_PASSWORD=
SESSION_SECRET=
WEBHOOK_SECRET=
N8N_AGENT_TOKEN=
INITIAL_ADMIN_PASSWORD=

INITIAL_ADMIN_EMAIL=admin@stirisk.co.za
INITIAL_ADMIN_NAME=STI Risk Super Admin
STAFF_EMAIL_DOMAIN=stirisk.co.za
ALLOW_STAFF_PASSWORD_LOGIN=false

# Microsoft Entra single-tenant SSO.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://stirisk.cloudmonkey.co.za/api/auth/microsoft/callback

# AI and agent integrations.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
HERMES_API_KEY=
N8N_AGENT_WEBHOOK_URL=http://n8n:5678/webhook/sti-risk/staff-agent/chat
N8N_WHATSAPP_AGENT_WEBHOOK_URL=http://n8n:5678/webhook/sti-risk/whatsapp-agent/chat
N8N_LEAD_IMAGE_WEBHOOK_URL=http://n8n:5678/webhook/sti-risk/contact-image-intake

# Yeastar/PABX integration. Keep credentials in the server secret store; never commit values.
YEASTAR_API_BASE_URL=https://139.84.242.214:8088
YEASTAR_CLIENT_ID=
YEASTAR_CLIENT_SECRET=
# SHA-256 fingerprint of the trusted Yeastar/UCCPBX certificate, without separators.
YEASTAR_TLS_CERT_SHA256=

# C1 cash-flow alert policy. Alerts are notification-only and internal by default.
CASH_FLOW_ALERT_BALANCE_THRESHOLD_CENTS=
CASH_FLOW_ALERT_OVERDUE_DAYS=7

# WhatsApp/messenger integrations.
WHATSAPP_WEBHOOK_SECRET=
MESSENGER_API_TOKEN=
MESSENGER_STATUS_URL=http://messenger:3010/readyz

# Lemlist outreach/growth integrations.
LEMLIST_BASIC_AUTH=
LEMLIST_API_USERNAME=
LEMLIST_API_PASSWORD=
LEMLIST_WEBHOOK_SECRET=

# Optional explicit staff passwords. Leave blank to generate non-printed passwords.
MELLISSA_PASSWORD=
VUSI_PASSWORD=
GEORGE_PASSWORD=
KIRIL_PASSWORD=
STEVE_PASSWORD=
